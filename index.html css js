<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Makueni County | Jobs & Recruitment Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ============ RESET & TOKENS ============ */
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --green-900:#04331f;
  --green-800:#06432a;
  --green-700:#0a6b3d;
  --green-600:#0d8449;
  --green-500:#12a05a;
  --green-100:#d6f0e2;
  --green-50:#eef8f3;
  --gold:#f0b429;
  --gold-dark:#b9820a;
  --ink:#0d1b14;
  --muted:#5c6b63;
  --line:#e2e9e4;
  --bg:#f5f8f6;
  --white:#fff;
  --danger:#c0392b;
  --radius:14px;
  --shadow-sm:0 1px 2px rgba(6,67,42,.06),0 2px 8px rgba(6,67,42,.05);
  --shadow-md:0 10px 30px rgba(6,67,42,.10);
  --shadow-lg:0 24px 70px rgba(6,67,42,.28);
}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  background:var(--bg);color:var(--ink);line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font:inherit;color:inherit}
.container{width:min(1180px,100% - 2.5rem);margin-inline:auto}

/* ============ DEMO BANNER ============ */
.demo-banner{
  background:linear-gradient(90deg,#1b1b1b,#2c2c2c);
  color:#ffd77a;font-size:.78rem;text-align:center;
  padding:.5rem 1rem;letter-spacing:.2px;
}
.demo-banner strong{color:#fff}

/* ============ HEADER ============ */
.topbar{
  background:var(--green-900);color:#bfe3cf;font-size:.78rem;
}
.topbar__inner{
  display:flex;justify-content:space-between;align-items:center;gap:1rem;
  padding:.45rem 0;flex-wrap:wrap;
}
.topbar__links{display:flex;gap:1.1rem}
.topbar__links a{opacity:.85;transition:.2s}
.topbar__links a:hover{opacity:1;color:#fff}

.nav{
  background:rgba(255,255,255,.92);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:60;
}
.nav__inner{display:flex;align-items:center;gap:1.5rem;padding:.75rem 0}
.brand{display:flex;align-items:center;gap:.7rem;flex-shrink:0}
.brand__mark{
  width:44px;height:44px;border-radius:12px;flex-shrink:0;
  background:linear-gradient(145deg,var(--green-600),var(--green-800));
  color:#fff;display:grid;place-items:center;font-weight:800;font-size:.95rem;
  letter-spacing:.5px;box-shadow:0 6px 16px rgba(10,107,61,.35);
  position:relative;overflow:hidden;
}
.brand__mark::after{
  content:"";position:absolute;inset:auto -6px -14px auto;
  width:34px;height:34px;border-radius:50%;background:rgba(240,180,41,.45);
}
.brand__text{display:flex;flex-direction:column;line-height:1.15}
.brand__text strong{font-size:.98rem;font-weight:800;color:var(--green-900)}
.brand__text small{font-size:.7rem;color:var(--muted);letter-spacing:.3px}

.nav__menu{display:flex;gap:.35rem;list-style:none;margin-left:auto}
.nav__menu a{
  padding:.5rem .85rem;border-radius:9px;font-size:.88rem;font-weight:500;
  color:var(--muted);transition:.2s;
}
.nav__menu a:hover{background:var(--green-50);color:var(--green-700)}
.nav__menu a.active{color:var(--green-700);background:var(--green-50);font-weight:600}

.nav__toggle{
  display:none;background:none;border:1px solid var(--line);
  width:42px;height:42px;border-radius:10px;cursor:pointer;font-size:1.1rem;
}
.nav__cta{margin-left:.5rem}

/* ============ BUTTONS ============ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
  padding:.7rem 1.35rem;border-radius:10px;border:1px solid transparent;
  font-weight:600;font-size:.88rem;cursor:pointer;transition:.2s;
  white-space:nowrap;
}
.btn--primary{background:var(--green-700);color:#fff;box-shadow:0 4px 14px rgba(10,107,61,.28)}
.btn--primary:hover{background:var(--green-800);transform:translateY(-1px)}
.btn--gold{background:var(--gold);color:#3d2a00;box-shadow:0 4px 14px rgba(240,180,41,.4)}
.btn--gold:hover{background:#ffc63d;transform:translateY(-1px)}
.btn--ghost{background:#fff;border-color:var(--line);color:var(--ink)}
.btn--ghost:hover{border-color:var(--green-500);color:var(--green-700)}
.btn--block{width:100%}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none!important}

/* ============ HERO ============ */
.hero{
  position:relative;overflow:hidden;
  background:
    radial-gradient(900px 420px at 88% -10%,rgba(240,180,41,.22),transparent 60%),
    radial-gradient(700px 400px at 5% 110%,rgba(18,160,90,.35),transparent 65%),
    linear-gradient(150deg,var(--green-900),var(--green-700) 65%,var(--green-600));
  color:#fff;padding:4.5rem 0 5.5rem;
}
.hero::before{
  content:"";position:absolute;inset:0;opacity:.07;
  background-image:linear-gradient(rgba(255,255,255,.6) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.6) 1px,transparent 1px);
  background-size:44px 44px;
}
.hero__inner{position:relative;z-index:1;max-width:760px}
.pill{
  display:inline-flex;align-items:center;gap:.5rem;
  background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.22);
  padding:.4rem .9rem;border-radius:999px;font-size:.76rem;font-weight:600;
  letter-spacing:.4px;margin-bottom:1.25rem;backdrop-filter:blur(6px);
}
.pill .dot{width:7px;height:7px;border-radius:50%;background:#5ce69a;box-shadow:0 0 0 4px rgba(92,230,154,.22)}
.hero h1{
  font-size:clamp(2rem,5vw,3.2rem);line-height:1.12;font-weight:800;
  letter-spacing:-.02em;margin-bottom:1rem;
}
.hero h1 span{color:var(--gold)}
.hero p{font-size:clamp(.95rem,2vw,1.08rem);color:#c9e6d6;max-width:600px;margin-bottom:2rem}

.searchbar{
  display:flex;gap:.6rem;background:#fff;padding:.55rem;border-radius:14px;
  box-shadow:var(--shadow-lg);max-width:640px;flex-wrap:wrap;
}
.searchbar__field{
  display:flex;align-items:center;gap:.6rem;flex:1 1 260px;
  padding:.5rem .8rem;border-radius:10px;background:#f6f9f7;
}
.searchbar__field svg{flex-shrink:0;opacity:.5}
.searchbar input{border:0;background:transparent;outline:none;width:100%;font-size:.9rem}
.searchbar .btn{flex:0 0 auto}

.hero__stats{
  display:flex;gap:2.5rem;margin-top:2.75rem;flex-wrap:wrap;
}
.stat strong{display:block;font-size:1.65rem;font-weight:800;color:var(--gold);line-height:1.2}
.stat span{font-size:.78rem;color:#a9cdbb;letter-spacing:.3px}

/* ============ SECTIONS ============ */
.section{padding:4rem 0}
.section__head{margin-bottom:2rem;max-width:640px}
.section__head h2{
  font-size:clamp(1.4rem,3vw,1.9rem);font-weight:800;letter-spacing:-.02em;
  color:var(--green-900);margin-bottom:.4rem;
}
.section__head p{color:var(--muted);font-size:.92rem}

/* ============ FILTERS ============ */
.filters{
  display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:.9rem;
  background:#fff;padding:1rem;border-radius:var(--radius);
  border:1px solid var(--line);box-shadow:var(--shadow-sm);margin-bottom:1.75rem;
}
.field{display:flex;flex-direction:column;gap:.35rem}
.field label{font-size:.72rem;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.field input,.field select,.field textarea{
  width:100%;padding:.7rem .85rem;border:1px solid var(--line);border-radius:10px;
  background:#fbfdfc;outline:none;transition:.2s;font-size:.88rem;
}
.field input:focus,.field select:focus,.field textarea:focus{
  border-color:var(--green-500);background:#fff;box-shadow:0 0 0 3px rgba(18,160,90,.13);
}

/* ============ JOB CARDS ============ */
.job-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.25rem}
.job-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);
  padding:1.4rem;display:flex;flex-direction:column;gap:1rem;
  box-shadow:var(--shadow-sm);transition:.25s;position:relative;overflow:hidden;
}
.job-card::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:4px;
  background:linear-gradient(var(--green-500),var(--green-800));
  transform:scaleY(0);transform-origin:top;transition:.3s;
}
.job-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:#cfe6da}
.job-card:hover::before{transform:scaleY(1)}
.job-card__top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}
.job-card h3{font-size:1.05rem;font-weight:700;color:var(--green-900);line-height:1.35}
.badge{
  font-size:.68rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
  padding:.3rem .6rem;border-radius:6px;background:var(--green-50);
  color:var(--green-700);border:1px solid var(--green-100);white-space:nowrap;
}
.job-meta{display:flex;flex-direction:column;gap:.5rem}
.job-meta div{display:flex;align-items:center;gap:.55rem;font-size:.83rem;color:var(--muted)}
.job-meta svg{flex-shrink:0;opacity:.65}
.job-card__foot{
  margin-top:auto;padding-top:1rem;border-top:1px dashed var(--line);
  display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap;
}
.fee{font-size:.75rem;color:var(--muted)}
.fee strong{color:var(--green-700);font-weight:800}
.deadline{font-size:.72rem;color:var(--danger);font-weight:600}

.empty{
  grid-column:1/-1;text-align:center;padding:3rem 1rem;color:var(--muted);
  background:#fff;border:1px dashed var(--line);border-radius:var(--radius);
}

/* ============ HOW IT WORKS ============ */
.steps-info{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.25rem}
.info-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);
  padding:1.5rem;box-shadow:var(--shadow-sm);
}
.info-card__num{
  width:36px;height:36px;border-radius:10px;display:grid;place-items:center;
  background:var(--green-50);color:var(--green-700);font-weight:800;
  margin-bottom:.9rem;border:1px solid var(--green-100);
}
.info-card h4{font-size:.98rem;margin-bottom:.35rem;color:var(--green-900)}
.info-card p{font-size:.85rem;color:var(--muted)}

/* ============ FOOTER ============ */
.footer{background:var(--green-900);color:#a9cdbb;padding:3.5rem 0 1.5rem;margin-top:2rem}
.footer__grid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:2.5rem}
.footer h5{color:#fff;font-size:.85rem;letter-spacing:.8px;text-transform:uppercase;margin-bottom:1rem}
.footer p,.footer a{font-size:.85rem}
.footer ul{list-style:none;display:flex;flex-direction:column;gap:.6rem}
.footer a:hover{color:#fff}
.footer__bottom{
  border-top:1px solid rgba(255,255,255,.12);margin-top:2.5rem;padding-top:1.25rem;
  display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.78rem;
}
.footer .brand__text strong{color:#fff}
.footer .brand__text small{color:#8fb8a3}

/* ============ MODAL ============ */
.overlay{
  position:fixed;inset:0;background:rgba(4,40,25,.62);backdrop-filter:blur(5px);
  display:flex;align-items:center;justify-content:center;padding:1rem;
  z-index:100;opacity:0;pointer-events:none;transition:.25s;
}
.overlay.open{opacity:1;pointer-events:auto}
.modal{
  background:#fff;border-radius:18px;width:min(720px,100%);
  max-height:92vh;display:flex;flex-direction:column;overflow:hidden;
  box-shadow:var(--shadow-lg);transform:translateY(18px) scale(.98);
  transition:.28s cubic-bezier(.2,.8,.3,1);
}
.overlay.open .modal{transform:none}
.modal__head{
  padding:1.25rem 1.5rem;border-bottom:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;
  background:linear-gradient(180deg,#fbfdfc,#fff);
}
.modal__head h3{font-size:1.05rem;font-weight:800;color:var(--green-900)}
.modal__head p{font-size:.8rem;color:var(--muted)}
.icon-btn{
  background:#f3f6f4;border:0;width:34px;height:34px;border-radius:9px;
  cursor:pointer;font-size:1.1rem;line-height:1;color:var(--muted);flex-shrink:0;transition:.2s;
}
.icon-btn:hover{background:#e7ede9;color:var(--ink)}

/* step indicator */
.steps{
  display:flex;align-items:center;gap:.35rem;padding:1rem 1.5rem;
  border-bottom:1px solid var(--line);list-style:none;background:#fbfdfc;
  overflow-x:auto;
}
.step{display:flex;align-items:center;gap:.55rem;flex-shrink:0}
.step__dot{
  width:26px;height:26px;border-radius:50%;display:grid;place-items:center;
  font-size:.74rem;font-weight:700;background:#e7ede9;color:var(--muted);
  transition:.25s;flex-shrink:0;
}
.step__label{font-size:.78rem;font-weight:600;color:var(--muted);white-space:nowrap}
.step.is-active .step__dot{background:var(--green-700);color:#fff;box-shadow:0 0 0 4px rgba(10,107,61,.14)}
.step.is-active .step__label{color:var(--green-900)}
.step.is-done .step__dot{background:var(--green-500);color:#fff}
.step.is-done .step__label{color:var(--green-700)}
.step__line{flex:1;height:2px;background:#e7ede9;min-width:18px;border-radius:2px}
.step__line.is-done{background:var(--green-500)}

.modal__body{padding:1.5rem;overflow-y:auto;flex:1}
.modal__foot{
  padding:1rem 1.5rem;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;gap:.75rem;background:#fbfdfc;flex-wrap:wrap;
}
.panel{display:none;animation:fade .3s ease}
.panel.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* job summary box */
.summary{
  background:var(--green-50);border:1px solid var(--green-100);
  border-radius:12px;padding:1rem 1.1rem;margin-bottom:1.4rem;
}
.summary h4{font-size:.95rem;color:var(--green-900);margin-bottom:.35rem}
.summary ul{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem .9rem;font-size:.78rem;color:var(--muted)}
.summary li{display:flex;align-items:center;gap:.35rem}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.form-grid .span-2{grid-column:1/-1}
.req{color:var(--danger)}
.error-msg{font-size:.72rem;color:var(--danger);display:none}
.field.invalid input,.field.invalid select{border-color:var(--danger);background:#fff6f5}
.field.invalid .error-msg{display:block}

.checkbox{
  display:flex;gap:.7rem;align-items:flex-start;font-size:.82rem;color:var(--muted);
  background:#fbfdfc;border:1px solid var(--line);padding:.85rem 1rem;border-radius:10px;
}
.checkbox input{width:17px;height:17px;margin-top:.15rem;accent-color:var(--green-700);flex-shrink:0}

/* payment */
.pay-amount{
  text-align:center;padding:1.5rem 1rem;border-radius:14px;margin-bottom:1.25rem;
  background:linear-gradient(150deg,var(--green-800),var(--green-600));color:#fff;
}
.pay-amount span{font-size:.78rem;color:#bfe3cf;letter-spacing:.5px;text-transform:uppercase}
.pay-amount strong{display:block;font-size:2.4rem;font-weight:800;letter-spacing:-.02em;margin-top:.2rem}
.pay-amount small{font-size:.76rem;color:#a9cdbb}

.mpesa-note{
  display:flex;gap:.7rem;align-items:flex-start;font-size:.78rem;color:var(--muted);
  background:#fffaf0;border:1px solid #f7e3b8;border-radius:10px;padding:.85rem 1rem;margin-top:1rem;
}
.mpesa-note strong{color:var(--gold-dark)}

.paybill{
  display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:1rem;
}
.paybill div{
  background:#fbfdfc;border:1px solid var(--line);border-radius:10px;padding:.7rem .9rem;
}
.paybill span{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.6px;color:var(--muted)}
.paybill strong{font-size:.95rem;color:var(--green-900);letter-spacing:.5px}

/* processing */
.processing{text-align:center;padding:2rem 1rem}
.spinner{
  width:52px;height:52px;border-radius:50%;margin:0 auto 1.25rem;
  border:4px solid var(--green-100);border-top-color:var(--green-600);
  animation:spin .8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.processing h4{font-size:1rem;margin-bottom:.4rem;color:var(--green-900)}
.processing p{font-size:.85rem;color:var(--muted)}

/* success */
.success{text-align:center;padding:1rem .5rem}
.success__icon{
  width:72px;height:72px;border-radius:50%;margin:0 auto 1.25rem;
  background:var(--green-50);border:2px solid var(--green-100);
  display:grid;place-items:center;
}
.success h3{font-size:1.25rem;color:var(--green-900);margin-bottom:.4rem}
.success > p{font-size:.87rem;color:var(--muted);margin-bottom:1.5rem}
.receipt{
  text-align:left;background:#fbfdfc;border:1px dashed var(--line);
  border-radius:12px;padding:1.1rem;margin-bottom:1.4rem;
}
.receipt-row{
  display:flex;justify-content:space-between;gap:1rem;font-size:.83rem;padding:.45rem 0;
  border-bottom:1px solid #eef2f0;
}
.receipt-row:last-child{border-bottom:0}
.receipt-row span{color:var(--muted)}
.receipt-row strong{color:var(--ink);text-align:right;font-weight:600}
.receipt-row strong.ref{color:var(--green-700);font-family:ui-monospace,monospace;letter-spacing:.5px}

/* toast */
.toast{
  position:fixed;bottom:1.5rem;left:50%;transform:translate(-50%,140%);
  background:var(--green-900);color:#fff;padding:.85rem 1.35rem;border-radius:12px;
  font-size:.85rem;font-weight:500;box-shadow:var(--shadow-lg);z-index:200;
  transition:.35s cubic-bezier(.2,.8,.3,1);max-width:min(90vw,420px);text-align:center;
}
.toast.show{transform:translate(-50%,0)}
.toast.err{background:#7d2418}

/* ============ RESPONSIVE ============ */
@media (max-width:960px){
  .footer__grid{grid-template-columns:1fr 1fr}
  .filters{grid-template-columns:1fr 1fr}
  .filters .field:first-child{grid-column:1/-1}
}
@media (max-width:760px){
  .topbar__links{display:none}
  .nav__toggle{display:grid;place-items:center;margin-left:auto}
  .nav__cta{display:none}
  .nav__menu{
    position:absolute;top:100%;left:0;right:0;background:#fff;
    flex-direction:column;gap:0;padding:.5rem 1.25rem 1rem;
    border-bottom:1px solid var(--line);box-shadow:var(--shadow-md);
    display:none;
  }
  .nav__menu.open{display:flex}
  .nav__menu a{display:block;padding:.75rem .5rem;border-radius:8px}
  .nav__inner{position:relative}
  .hero{padding:3rem 0 3.5rem}
  .hero__stats{gap:1.75rem;margin-top:2rem}
  .section{padding:2.75rem 0}
  .filters{grid-template-columns:1fr}
  .job-grid{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr}
  .paybill{grid-template-columns:1fr}
  .modal{max-height:95vh;border-radius:14px}
  .modal__body{padding:1.15rem}
  .modal__head,.modal__foot,.steps{padding-inline:1.15rem}
  .modal__foot .btn{flex:1}
  .step__label{display:none}
  .footer__grid{grid-template-columns:1fr;gap:2rem}
}
@media (max-width:400px){
  .container{width:calc(100% - 1.75rem)}
  .searchbar{padding:.45rem}
  .searchbar .btn{width:100%}
}
</style>
</head>
<body>

<!-- DEMO NOTICE -->
<div class="demo-banner">
  <strong>UI/UX Prototype</strong> — demo design only. No real payments are processed. Not an official government website.
</div>

<!-- HEADER -->
<header>
  <div class="topbar">
    <div class="container topbar__inner">
      <span>Official Recruitment Portal · County Government of Makueni</span>
      <span class="topbar__links">
        <a href="#">Help &amp; FAQs</a>
        <a href="#">+254 700 000 000</a>
      </span>
    </div>
  </div>

  <nav class="nav">
    <div class="container nav__inner">
      <a class="brand" href="#">
        <span class="brand__mark">MK</span>
        <span class="brand__text">
          <strong>Makueni County</strong>
          <small>Jobs &amp; Recruitment Portal</small>
        </span>
      </a>
      <button class="nav__toggle" id="navToggle" aria-label="Toggle menu">☰</button>
      <ul class="nav__menu" id="navMenu">
        <li><a href="#" class="active">Home</a></li>
        <li><a href="#jobs">Vacancies</a></li>
        <li><a href="#how">How to Apply</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a href="#jobs" class="btn btn--primary nav__cta">Apply Now</a>
    </div>
  </nav>
</header>

<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="pill"><span class="dot"></span> 12 Open Vacancies · Applications Closing Soon</span>
      <h1>Build your career with <span>Makueni County</span></h1>
      <p>Apply for county government positions in health, water, agriculture,
